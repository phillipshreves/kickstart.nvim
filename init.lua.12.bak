--[[
  Neovim 0.12+ native-first config.

  What replaced what:
    lazy.nvim                -> vim.pack (:help vim.pack)
    blink.cmp + LuaSnip      -> 'autocomplete' option + vim.lsp.completion + vim.snippet
    telescope (+plenary,
      fzf-native, ui-select) -> mini.pick + mini.extra (already ship in mini.nvim)
    neo-tree (+nui)          -> mini.files  (netrw is the 100%-native option)
    nvim-autopairs           -> mini.pairs
    todo-comments (+plenary) -> mini.hipatterns
    mini.statusline          -> 0.12 default statusline (shows diagnostics + LSP progress)
    fidget                   -> 0.12 default statusline / vim.lsp.status()
    trouble                  -> vim.diagnostic.setqflist / setloclist + quickfix
    bufferline               -> dropped (native tabline if you want tabs)
    which-key                -> dropped (mini.clue is a free re-add if you miss it)
    indent-blankline         -> dropped
    guess-indent             -> dropped (native editorconfig support + fixed settings)
    lazydev                  -> lua_ls workspace settings below
    mason-lspconfig          -> dropped (mason-tool-installer uses Mason names directly)

  Still plugins (no native equivalent):
    nvim-lspconfig (server config data), mason + mason-tool-installer, conform,
    mini.nvim, gitsigns, the DAP stack, copilot.lua, sonokai.

  First run: plugins auto-install via vim.pack. Then run :Copilot auth once
  (this was previously lazy.nvim's `build` step). Old lazy.nvim data in
  ~/.local/share/nvim/lazy/ can be deleted. Commit nvim-pack-lock.json.
--]]

-- Set <space> as the leader key (must happen before plugins are loaded)
vim.g.mapleader = ' '
vim.g.maplocalleader = ' '

vim.g.have_nerd_font = true

-- [[ Options ]] See `:help vim.o`

-- Indentation
vim.o.autoindent = true
vim.o.smartindent = true
vim.o.shiftwidth = 2
vim.o.tabstop = 2
vim.o.softtabstop = 2
vim.o.shiftround = true

-- Folding (native LSP foldexpr)
vim.o.foldmethod = 'expr'
vim.o.foldcolumn = 'auto'
vim.o.foldlevel = 99
vim.o.foldlevelstart = 99
vim.o.foldnestmax = 3
vim.o.foldenable = true
vim.o.foldexpr = 'v:lua.vim.lsp.foldexpr()'

-- One border setting for all floating windows
vim.o.winborder = 'rounded'

-- NATIVE (0.12): insert-mode auto-completion, no completion plugin needed.
-- See :help 'autocomplete', :help 'complete', :help ins-completion
vim.o.autocomplete = true
-- Sources: omnifunc (LSP sets this on attach), then current buffer.
-- Add w/b/u etc. if you want completion from other windows/buffers.
vim.o.complete = 'o,.'
vim.o.completeopt = 'menu,menuone,noselect,fuzzy,popup'
vim.o.pummaxwidth = 60

vim.o.number = true
-- vim.o.relativenumber = true
vim.o.mouse = 'a'
-- NOTE: showmode stays on since the default statusline doesn't display the
-- mode. If you go back to a custom statusline, set this to false again.
vim.o.showmode = true

-- Sync clipboard between OS and Neovim (scheduled to keep startup fast)
vim.schedule(function()
  vim.o.clipboard = 'unnamedplus'
end)
-- Delete/change without yanking (prevents system clipboard overwrite)
vim.keymap.set({ 'n', 'v' }, 'd', '"_d', { noremap = true, silent = true })
vim.keymap.set('n', 'dd', '"_dd', { noremap = true, silent = true })
vim.keymap.set({ 'n', 'v' }, 'x', '"_x', { noremap = true, silent = true })
vim.keymap.set({ 'n', 'v' }, 'c', '"_c', { noremap = true, silent = true })
vim.keymap.set('n', 'cc', '"_cc', { noremap = true, silent = true })

vim.o.breakindent = true
vim.o.undofile = true
vim.o.ignorecase = true
vim.o.smartcase = true
vim.o.signcolumn = 'yes'
vim.o.updatetime = 250
vim.o.timeoutlen = 300
vim.o.splitright = true
vim.o.splitbelow = true
vim.o.list = true
vim.opt.listchars = { tab = '» ', trail = '·', nbsp = '␣' }
vim.o.inccommand = 'split'
vim.o.cursorline = true
vim.o.scrolloff = 5
vim.o.confirm = true

-- [[ Basic Keymaps ]]

vim.keymap.set('n', '<Esc>', '<cmd>nohlsearch<CR>')

-- Diagnostic lists (replaces trouble.nvim; navigate with :cnext/:cprev or ]q/[q)
vim.keymap.set('n', '<leader>q', vim.diagnostic.setloclist, { desc = 'Buffer diagnostics -> loclist' })
vim.keymap.set('n', '<leader>xx', vim.diagnostic.setqflist, { desc = 'All diagnostics -> quickfix' })

vim.keymap.set('t', '<Esc><Esc>', '<C-\\><C-n>', { desc = 'Exit terminal mode' })

vim.keymap.set('n', '<C-h>', '<C-w><C-h>', { desc = 'Move focus to the left window' })
vim.keymap.set('n', '<C-l>', '<C-w><C-l>', { desc = 'Move focus to the right window' })
vim.keymap.set('n', '<C-j>', '<C-w><C-j>', { desc = 'Move focus to the lower window' })
vim.keymap.set('n', '<C-k>', '<C-w><C-k>', { desc = 'Move focus to the upper window' })

-- Keep cursor centered when searching
vim.keymap.set('n', 'n', 'nzzzv')
vim.keymap.set('n', 'N', 'Nzzzv')

-- Paste over selection without yanking it / delete without yanking
vim.keymap.set('x', '<leader>p', '"_dP')
vim.keymap.set('x', '<leader>d', '"_d')

-- NATIVE: jump between vim.snippet tabstops (replaces LuaSnip's <Tab> maps).
-- See :help vim.snippet
vim.keymap.set({ 'i', 's' }, '<Tab>', function()
  if vim.snippet.active { direction = 1 } then
    vim.snippet.jump(1)
  else
    return '<Tab>'
  end
end, { expr = true, silent = true })
vim.keymap.set({ 'i', 's' }, '<S-Tab>', function()
  if vim.snippet.active { direction = -1 } then
    vim.snippet.jump(-1)
  else
    return '<S-Tab>'
  end
end, { expr = true, silent = true })

-- [[ Basic Autocommands ]]

vim.api.nvim_create_autocmd('TextYankPost', {
  desc = 'Highlight when yanking (copying) text',
  group = vim.api.nvim_create_augroup('kickstart-highlight-yank', { clear = true }),
  callback = function()
    vim.hl.on_yank()
  end,
})

-- [[ Big file handling ]]
vim.api.nvim_create_autocmd('BufReadPre', {
  desc = 'Mark big files',
  group = vim.api.nvim_create_augroup('bigfile-detect', { clear = true }),
  callback = function(args)
    local ok, stats = pcall(vim.uv.fs_stat, vim.api.nvim_buf_get_name(args.buf))
    local largeFileSizeRequirement = 1024 * 512
    if ok and stats and stats.size > largeFileSizeRequirement then
      vim.b[args.buf].bigfile = true
    end
  end,
})
vim.api.nvim_create_autocmd('LspAttach', {
  desc = 'Detach LSP from big files',
  group = vim.api.nvim_create_augroup('bigfile-lsp', { clear = true }),
  callback = function(args)
    if vim.b[args.buf].bigfile then
      vim.schedule(function()
        vim.lsp.buf_detach_client(args.buf, args.data.client_id)
      end)
    end
  end,
})
vim.api.nvim_create_autocmd('BufWinEnter', {
  group = vim.api.nvim_create_augroup('bigfile-folds', { clear = true }),
  callback = function(args)
    if vim.b[args.buf].bigfile then
      vim.opt_local.foldmethod = 'manual'
      vim.opt_local.foldexpr = ''
    end
  end,
})

-- [[ Native LSP configuration ]]

-- Custom clangd (ESP-IDF aware).
local esp_clangd = '/Users/phil/.espressif/tools/esp-clang/esp-19.1.2_20250312/esp-clang/bin/clangd'
local clangd_flags = {
  '--background-index',
  '--clang-tidy',
  '-j=8',
  '--fallback-style=llvm',
  '--all-scopes-completion',
  '--completion-style=detailed',
  '--header-insertion=iwyu',
  '--header-insertion-decorators',
  '--pch-storage=memory',
}

-- Server list. Empty table = use nvim-lspconfig defaults as-is.
local servers = {
  clangd = {
    cmd = function(dispatchers, config)
      local bin = 'clangd'
      if config.root_dir and vim.uv.fs_stat(vim.fs.joinpath(config.root_dir, 'sdkconfig')) then
        bin = esp_clangd
      end
      return vim.lsp.rpc.start({ bin, unpack(clangd_flags) }, dispatchers)
    end,
    root_markers = { '.clangd', 'compile_commands.json', 'sdkconfig', '.git' },
    filetypes = { 'c', 'cpp', 'objc', 'objcpp', 'cuda', 'proto' },
  },
  gopls = {},
  pyright = {},
  rust_analyzer = {},
  vtsls = {},
  eslint = {},
  tailwindcss = {},
  docker_compose_language_service = {},
  docker_language_server = {},
  yamlls = {},
  lua_ls = {
    settings = {
      Lua = {
        completion = { callSnippet = 'Replace' },
        -- Replaces lazydev for editing this config: know the Neovim runtime.
        -- (lazydev is smarter about plugin sources; re-add it if you miss it.)
        runtime = { version = 'LuaJIT' },
        workspace = {
          checkThirdParty = false,
          library = {
            vim.env.VIMRUNTIME,
            '${3rd}/luv/library',
          },
        },
        -- diagnostics = { disable = { 'missing-fields' } },
      },
    },
  },
}

-- [[ Plugins: vim.pack (NATIVE, 0.12) ]]
-- Plugins are cloned into stdpath('data')/site/pack/core/ on first run and
-- loaded immediately. Update with :lua vim.pack.update()  (review buffer opens).
-- Remove with :lua vim.pack.del({ 'name' }). Lockfile: nvim-pack-lock.json.
vim.pack.add {
  -- LSP config data + tooling installs
  'https://github.com/neovim/nvim-lspconfig',
  'https://github.com/mason-org/mason.nvim',
  'https://github.com/WhoIsSethDaniel/mason-tool-installer.nvim',

  -- Formatting via external CLIs (stylua/prettier aren't LSPs)
  'https://github.com/stevearc/conform.nvim',

  -- One plugin, many modules: ai, surround, pick, extra, files, pairs,
  -- hipatterns, icons
  'https://github.com/nvim-mini/mini.nvim',

  -- Git gutter, hunks, blame
  'https://github.com/lewis6991/gitsigns.nvim',

  -- Debugging
  'https://github.com/mfussenegger/nvim-dap',
  'https://github.com/nvim-neotest/nvim-nio',
  'https://github.com/rcarriga/nvim-dap-ui',
  'https://github.com/jay-babu/mason-nvim-dap.nvim',
  'https://github.com/leoluz/nvim-dap-go',

  -- AI + colorscheme
  'https://github.com/zbirenbaum/copilot.lua',
  'https://github.com/sainnhe/sonokai',
}

-- [[ Colorscheme ]]
vim.g.sonokai_current_word = 'high contrast background'
vim.g.sonokai_enable_italic = true
--vim.g.sonokai_diagnostic_text_highlight = true
--vim.g.sonokai_style = 'atlantis'
vim.cmd.colorscheme 'sonokai'

-- [[ mini.nvim modules ]]

-- Textobjects: va), yinq, ci' ...
require('mini.ai').setup { n_lines = 500 }
-- Surround: saiw), sd', sr)'
require('mini.surround').setup()
-- Auto-pairs (replaces nvim-autopairs)
require('mini.pairs').setup()
-- Icons (replaces nvim-web-devicons for mini.files/mini.pick)
require('mini.icons').setup()

-- TODO/FIXME/etc highlighting (replaces todo-comments)
local hipatterns = require 'mini.hipatterns'
hipatterns.setup {
  highlighters = {
    fixme = { pattern = '%f[%w]()FIXME()%f[%W]', group = 'MiniHipatternsFixme' },
    fix = { pattern = '%f[%w]()FIX()%f[%W]', group = 'MiniHipatternsFixme' },
    bug = { pattern = '%f[%w]()BUG()%f[%W]', group = 'MiniHipatternsFixme' },
    hack = { pattern = '%f[%w]()HACK()%f[%W]', group = 'MiniHipatternsHack' },
    warn = { pattern = '%f[%w]()WARN()%f[%W]', group = 'MiniHipatternsHack' },
    todo = { pattern = '%f[%w]()TODO()%f[%W]', group = 'MiniHipatternsTodo' },
    note = { pattern = '%f[%w]()NOTE()%f[%W]', group = 'MiniHipatternsNote' },
    -- Highlight hex color strings (#rrggbb) with their own color
    hex_color = hipatterns.gen_highlighter.hex_color(),
  },
}

-- File explorer (replaces neo-tree). Popup-style column view; use `=` to
-- sync manual edits (rename/delete files by editing the buffer!).
-- Fully-native alternative: netrw via :Explore / :Lexplore.
require('mini.files').setup {
  windows = { preview = true },
}
local minifiles_toggle = function()
  local mf = require 'mini.files'
  if not mf.close() then
    mf.open(vim.api.nvim_buf_get_name(0), false)
  end
end
vim.keymap.set('n', '\\', minifiles_toggle, { desc = 'File explorer (mini.files)' })
vim.keymap.set('n', '<leader>nt', minifiles_toggle, { desc = 'File explorer toggle' })

-- Fuzzy pickers (replace telescope + fzf-native + ui-select + plenary)
require('mini.pick').setup()
require('mini.extra').setup()
vim.ui.select = MiniPick.ui_select -- dropdown-style vim.ui.select (code actions etc.)

local pick = MiniPick.builtin
local extra = MiniExtra.pickers
vim.keymap.set('n', '<leader>sh', pick.help, { desc = '[S]earch [H]elp' })
vim.keymap.set('n', '<leader>sk', extra.keymaps, { desc = '[S]earch [K]eymaps' })
vim.keymap.set('n', '<leader>sf', pick.files, { desc = '[S]earch [F]iles' })
vim.keymap.set('n', '<leader>sw', function()
  pick.grep { pattern = vim.fn.expand '<cword>' }
end, { desc = '[S]earch current [W]ord' })
vim.keymap.set('n', '<leader>sg', pick.grep_live, { desc = '[S]earch by [G]rep' })
vim.keymap.set('n', '<leader>sd', extra.diagnostic, { desc = '[S]earch [D]iagnostics' })
vim.keymap.set('n', '<leader>sr', pick.resume, { desc = '[S]earch [R]esume' })
vim.keymap.set('n', '<leader>s.', extra.oldfiles, { desc = '[S]earch Recent Files' })
vim.keymap.set('n', '<leader><leader>', pick.buffers, { desc = '[ ] Find existing buffers' })
vim.keymap.set('n', '<leader>/', function()
  extra.buf_lines { scope = 'current' }
end, { desc = '[/] Fuzzily search in current buffer' })
vim.keymap.set('n', '<leader>s/', function()
  extra.buf_lines { scope = 'all' }
end, { desc = '[S]earch [/] in Open Files' })
vim.keymap.set('n', '<leader>sn', function()
  pick.files(nil, { source = { cwd = vim.fn.stdpath 'config' } })
end, { desc = '[S]earch [N]eovim files' })

-- git pickers
vim.keymap.set('n', '<leader>gst', extra.git_hunks, { desc = '[G]it [St]atus (hunks)' })
vim.keymap.set('n', '<leader>gco', extra.git_commits, { desc = '[G]it [Co]mmits' })
vim.keymap.set('n', '<leader>gcb', function()
