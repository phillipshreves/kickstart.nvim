end, { desc = '[G]it [C]ommits [B]uffer' })
vim.keymap.set('n', '<leader>gbr', extra.git_branches, { desc = '[G]it [Br]anches' })
-- NOTE: mini.extra has no stash picker; use `:!git stash list` or gitsigns.

